{
  "info": {
    "name": "Shop Warehouse API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Items",
      "item": [
        {
          "name": "Create item (with variants)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Shirt\",\n  \"description\": \"Cotton shirt\",\n  \"price\": 100000,\n  \"stock\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('itemId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create item (no variants)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Water Bottle\",\n  \"description\": \"Stainless steel\",\n  \"price\": 75000,\n  \"stock\": 40\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('plainItemId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            }
          }
        },
        {
          "name": "Get item",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}"
              ]
            }
          }
        },
        {
          "name": "Update item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{plainItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{plainItemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Water Bottle\",\n  \"description\": \"Stainless steel\",\n  \"price\": 80000,\n  \"stock\": 40\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get item (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "999999"
              ]
            }
          }
        },
        {
          "name": "Create item invalid (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": -1,\n  \"stock\": -5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Variants",
      "item": [
        {
          "name": "Create variant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}/variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}",
                "variants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Red - M\",\n  \"price\": 100000,\n  \"stock\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('variantId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create variant (stock 0)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}/variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}",
                "variants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Blue - L\",\n  \"price\": 110000,\n  \"stock\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emptyVariantId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List variants of item",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}/variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}",
                "variants"
              ]
            }
          }
        },
        {
          "name": "Get variant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/variants/{{variantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "variants",
                "{{variantId}}"
              ]
            }
          }
        },
        {
          "name": "Update variant",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/variants/{{variantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "variants",
                "{{variantId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Red - M\",\n  \"price\": 105000,\n  \"stock\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create variant invalid (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}/variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}",
                "variants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": -1,\n  \"stock\": -1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Sales",
      "item": [
        {
          "name": "Sell item (no variants)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": {{plainItemId}},\n  \"quantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sell variant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": {{itemId}},\n  \"variantId\": {{variantId}},\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sell more than stock (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": {{plainItemId}},\n  \"quantity\": 9999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sell variant with stock 0 (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": {{itemId}},\n  \"variantId\": {{emptyVariantId}},\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sell item with variants without variantId (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": {{itemId}},\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sell quantity 0 (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sales"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": {{plainItemId}},\n  \"quantity\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "4. Cleanup",
      "item": [
        {
          "name": "Delete variant",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/variants/{{emptyVariantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "variants",
                "{{emptyVariantId}}"
              ]
            }
          }
        },
        {
          "name": "Delete item (cascades variants)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}"
              ]
            }
          }
        },
        {
          "name": "Delete item (no variants)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{plainItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{plainItemId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}